# Copy to .env.local and fill in from your Supabase project
# (Supabase Dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Company domain allowed to register. Defaults to scpronto.com if unset.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=scpronto.com

# --- Optional: email admins when a new account needs approval -------------
# In-app notifications work without any of these. Set all of them to also send
# email (via Resend). If any is missing, email is skipped silently.
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_FROM_EMAIL=SC Pronto <noreply@yourdomain.com>
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Supabase → Settings → API
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app  # for the "Review" link
